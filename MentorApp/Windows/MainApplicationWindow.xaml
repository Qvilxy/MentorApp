<Window x:Class="MentorApp.MainApplicationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск ментора" Height="600" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#ECF0F1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#2C3E50">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="btnMentors" Content="Менторы" Width="120" Margin="5"
                        Background="#3498DB" Foreground="White" Click="BtnMentors_Click"/>
                <Button x:Name="btnApplications" Width="150" Margin="5"
                        Background="#3498DB" Foreground="White" Click="BtnApplications_Click"/>
                <Button x:Name="btnMeetings" Content="Встречи" Width="120" Margin="5"
                        Background="#3498DB" Foreground="White" Click="BtnMeetings_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="10,0">
                <Button x:Name="btnUserInfo" VerticalAlignment="Center"
                        Background="#34495E" BorderThickness="0"
                        Foreground="White" FontSize="14" Margin="0,0,10,0"
                        Click="BtnUserInfo_Click" Cursor="Hand"
                        Padding="15,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2980B9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="Выход" Width="80" Margin="5"
                        Background="#E74C3C" Foreground="White" Click="BtnLogout_Click"/>
            </StackPanel>

            <!-- Кнопки администратора -->
            <StackPanel x:Name="adminPanel" Orientation="Horizontal" DockPanel.Dock="Left" Visibility="Collapsed">
                <Button Content="Пользователи" Width="120" Margin="5"
                        Background="#9B59B6" Foreground="White" Click="BtnUsers_Click"/>
            </StackPanel>
        </DockPanel>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>