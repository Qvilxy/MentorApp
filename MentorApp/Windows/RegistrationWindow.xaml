<Window x:Class="MentorApp.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="500" Width="450"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>
            <TextBlock Text="ФИО:"/>
            <TextBox x:Name="txtFullName" Height="30"/>
            <TextBlock Text="Email:" Margin="0,10,0,0"/>
            <TextBox x:Name="txtEmail" Height="30"/>
            <TextBlock Text="Логин:" Margin="0,10,0,0"/>
            <TextBox x:Name="txtLogin" Height="30"/>
            <TextBlock Text="Пароль:" Margin="0,10,0,0"/>
            <PasswordBox x:Name="txtPassword" Height="30"/>
            <TextBlock Text="Роль:" Margin="0,10,0,0"/>
            <ComboBox x:Name="cmbRole" Height="30"/>
            <Button Content="Зарегистрироваться" Height="35" Margin="0,20,0,10"
                    Background="#27AE60" Foreground="White" FontSize="14"
                    Click="BtnRegister_Click"/>
            <Button Content="Назад к входу" Height="30"
                    Background="Transparent" Foreground="#3498DB"
                    Click="BtnBack_Click"/>
        </StackPanel>
    </Grid>
</Window>