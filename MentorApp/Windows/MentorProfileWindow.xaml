<Window x:Class="MentorApp.MentorProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль ментора" Height="600" Width="700"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Профиль ментора" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock x:Name="txtFullName" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtEmail" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtDirection" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtExperience" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtHourlyRate" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtAverageRating" FontSize="16" FontWeight="Bold" 
                       Foreground="#E67E22" Margin="0,10,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Полученные отзывы:" FontSize="16" FontWeight="Bold"
                   Margin="0,0,0,10" Foreground="#2C3E50"/>

        <DataGrid x:Name="dgReviews" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" Margin="0,30,0,0"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Менти" Binding="{Binding Mentee.User.FullName}" Width="150"/>
                <DataGridTextColumn Header="Оценка" Binding="{Binding Rating}" Width="80"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                <DataGridTextColumn Header="Дата встречи" Binding="{Binding ReviewDate, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3" Content="Закрыть" Width="150" Height="35"
                Margin="0,20,0,0" Background="#E74C3C" Foreground="White"
                HorizontalAlignment="Center" Click="BtnClose_Click"/>
    </Grid>
</Window>