<Window x:Class="MentorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - Поиск ментора" Height="389" Width="450"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>
            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" Height="30" FontSize="14"/>
            <TextBlock Text="Пароль:" Margin="0,10,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="30" FontSize="14"/>
            <Button Content="Войти" Height="35" Margin="0,20,0,10"
                    Background="#3498DB" Foreground="White" FontSize="14"
                    Click="BtnLogin_Click"/>
            <Button Content="Регистрация" Height="30"
                    Background="Transparent" Foreground="#3498DB"
                    Click="BtnRegister_Click"/>
        </StackPanel>
    </Grid>
</Window>