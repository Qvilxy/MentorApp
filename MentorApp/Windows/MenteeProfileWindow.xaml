<Window x:Class="MentorApp.MenteeProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль менти" Height="300" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Профиль менти" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#2C3E50"/>

            <TextBlock x:Name="txtFullName" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
            <TextBlock x:Name="txtEmail" FontSize="14" Margin="0,0,0,30"/>

            <Button Content="Закрыть" Width="150" Height="35"
                    Background="#E74C3C" Foreground="White"
                    HorizontalAlignment="Center" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>