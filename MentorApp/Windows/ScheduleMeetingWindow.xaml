<Window x:Class="MentorApp.ScheduleMeetingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Планирование встречи" Height="504" Width="450"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.156"/>
                    <RotateTransform/>
                    <TranslateTransform X="-0.512"/>
                </TransformGroup>
            </StackPanel.RenderTransform>
            <TextBlock Text="Планирование встречи" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>

            <TextBlock Text="Дата встречи:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DatePicker x:Name="dpMeetingDate" Height="35" FontSize="14" Margin="0,0,0,15"/>

            <TextBlock Text="Время встречи:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbMeetingTime" Height="35" FontSize="14" Margin="0,0,0,15"
                      IsEditable="True" Text="10:00">
                <ComboBoxItem Content="09:00"/>
                <ComboBoxItem Content="09:30"/>
                <ComboBoxItem Content="10:00"/>
                <ComboBoxItem Content="10:30"/>
                <ComboBoxItem Content="11:00"/>
                <ComboBoxItem Content="11:30"/>
                <ComboBoxItem Content="12:00"/>
                <ComboBoxItem Content="12:30"/>
                <ComboBoxItem Content="13:00"/>
                <ComboBoxItem Content="13:30"/>
                <ComboBoxItem Content="14:00"/>
                <ComboBoxItem Content="14:30"/>
                <ComboBoxItem Content="15:00"/>
                <ComboBoxItem Content="15:30"/>
                <ComboBoxItem Content="16:00"/>
                <ComboBoxItem Content="16:30"/>
                <ComboBoxItem Content="17:00"/>
                <ComboBoxItem Content="17:30"/>
                <ComboBoxItem Content="18:00"/>
            </ComboBox>

            <TextBlock Text="Тема встречи:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtTopic" Height="60" FontSize="14" Margin="0,0,0,20"
                     TextWrapping="Wrap" AcceptsReturn="True"/>

            <Button Content="Запланировать" Height="40" Margin="0,0,0,10"
                    Background="#27AE60" Foreground="White" FontSize="14"
                    Click="BtnSchedule_Click"/>
            <Button Content="Отмена" Height="35"
                    Background="#E74C3C" Foreground="White" FontSize="14"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>