<Window x:Class="MentorApp.AddReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оставить отзыв" Height="492" Width="500"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Оставить отзыв ментору" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>

            <TextBlock Text="Выберите ментора:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbMentor" Height="35" FontSize="14" Margin="0,0,0,15"/>

            <TextBlock Text="Оценка (1-5 звезд):" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbRating" Height="35" FontSize="14" Margin="0,0,0,15">
                <ComboBoxItem Content="⭐ (1 звезда)"/>
                <ComboBoxItem Content="⭐⭐ (2 звезды)"/>
                <ComboBoxItem Content="⭐⭐⭐ (3 звезды)"/>
                <ComboBoxItem Content="⭐⭐⭐⭐ (4 звезды)"/>
                <ComboBoxItem Content="⭐⭐⭐⭐⭐ (5 звезд)"/>
            </ComboBox>

            <TextBlock Text="Комментарий:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtComment" Height="80" FontSize="14" 
                     TextWrapping="Wrap" Margin="0,0,0,20"/>

            <Button Content="Отправить отзыв" Height="40" Margin="0,0,0,10"
                    Background="#27AE60" Foreground="White" FontSize="14"
                    Click="BtnSubmit_Click"/>
            <Button Content="Отмена" Height="35"
                    Background="#E74C3C" Foreground="White" FontSize="14"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>