<Window x:Class="MentorApp.MentorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о менторе" Height="450" Width="500"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock x:Name="txtName" FontSize="22" FontWeight="Bold"/>
        <TextBlock x:Name="txtDirection" FontSize="14" Margin="0,10,0,0"/>
        <TextBlock x:Name="txtExperience" FontSize="14"/>
        <TextBlock x:Name="txtRate" FontSize="14"/>
        <TextBlock Text="Описание:" FontWeight="Bold" Margin="0,15,0,5"/>
        <TextBlock x:Name="txtDescription" TextWrapping="Wrap"/>

        <Separator Margin="0,20,0,10"/>
        <TextBlock Text="Ваш комментарий к заявке:" FontWeight="Bold"/>
        <TextBox x:Name="txtComment" Height="60" TextWrapping="Wrap" Margin="0,5,0,10"/>
        <Button Content="Отправить заявку ментору" Height="35"
                Background="#E67E22" Foreground="White" FontSize="14"
                Click="BtnApply_Click"/>
    </StackPanel>
</Window>