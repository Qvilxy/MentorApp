<Window x:Class="MentorApp.ProfileSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки профиля ментора" Height="500" Width="500"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">
    <Grid Margin="30">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Настройки профиля" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>

            <TextBlock Text="ФИО:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtFullName" FontSize="14" Margin="0,0,0,15"
                       Foreground="#2C3E50"/>

            <TextBlock Text="Email:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtEmail" FontSize="14" Margin="0,0,0,15"
                       Foreground="#2C3E50"/>

            <TextBlock Text="Ставка (₽/час):" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtHourlyRate" Height="35" FontSize="14"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Направление менторства:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cmbDirection" Height="35" FontSize="14"
                      Margin="0,0,0,15"/>

            <TextBlock Text="Стаж (лет):" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtExperienceYears" Height="35" FontSize="14"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Стаж (месяцев):" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtExperienceMonths" Height="35" FontSize="14"
                     Margin="0,0,0,20"/>

            <Button Content="Сохранить" Height="40" Margin="0,0,0,10"
                    Background="#27AE60" Foreground="White" FontSize="14"
                    Click="BtnSave_Click"/>
            <Button Content="Отмена" Height="35"
                    Background="#E74C3C" Foreground="White" FontSize="14"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>