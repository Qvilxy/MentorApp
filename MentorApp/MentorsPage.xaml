<Page x:Class="MentorApp.MentorsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#ECF0F1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="txtSearch" Width="300" Height="30" FontSize="14"/>
            <Button Content="Поиск" Width="100" Margin="10,0,0,0"
                    Background="#3498DB" Foreground="White" Click="BtnSearch_Click"/>
            <Button Content="Обновить" Width="100" Margin="10,0,0,0"
                    Background="#27AE60" Foreground="White" Click="BtnRefresh_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgMentors" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" FontSize="13"
                  MouseDoubleClick="DgMentors_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding MentorID}" Width="50"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding User.FullName}" Width="200"/>
                <DataGridTextColumn Header="Направление" Binding="{Binding Direction.DirectionName}" Width="150"/>
                <DataGridTextColumn Header="Опыт (лет)" Binding="{Binding Experience}" Width="100"/>
                <DataGridTextColumn Header="Ставка (₽/час)" Binding="{Binding HourlyRate}" Width="120"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>