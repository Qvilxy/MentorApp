<Page x:Class="MentorApp.ApplicationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#ECF0F1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtPageTitle" Text="Заявки" FontSize="22" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,10"/>

        <DataGrid x:Name="dgApplications" 
          Grid.Row="1" 
          AutoGenerateColumns="False"
          IsReadOnly="True" 
          CanUserAddRows="False" 
          FontSize="13"
          MouseDoubleClick="DgApplications_MouseDoubleClick"
          PreviewMouseRightButtonDown="DgApplications_PreviewMouseRightButtonDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ApplicationID}" Width="50"/>
                <DataGridTextColumn x:Name="colMentee" Header="Менти" Binding="{Binding Mentee.User.FullName}" Width="180"/>
                <DataGridTextColumn x:Name="colMentor" Header="Ментор" Binding="{Binding Mentor.User.FullName}" Width="180"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>