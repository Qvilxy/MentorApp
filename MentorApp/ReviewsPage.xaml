<Page x:Class="MentorApp.ReviewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#ECF0F1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Отзывы" FontSize="22" FontWeight="Bold" 
                       Foreground="#2C3E50" VerticalAlignment="Center"/>
            <Button x:Name="btnAddReview" Content="Оставить отзыв" Width="150" Margin="20,0,0,0"
                    Background="#27AE60" Foreground="White" Click="BtnAddReview_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgReviews" Grid.Row="1" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ментор" Binding="{Binding Mentor.User.FullName}" Width="200"/>
                <DataGridTextColumn Header="Менти" Binding="{Binding Mentee.User.FullName}" Width="200"/>
                <DataGridTextColumn Header="Оценка" Binding="{Binding Rating}" Width="80"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                <DataGridTextColumn x:Name="colDate" Header="Дата" Binding="{Binding ReviewDate, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>